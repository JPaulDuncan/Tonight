{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"],
      "env": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876"
      }
    },
    "unity": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${UNITY_MCP_SERVER_DIR}",
        "server.py"
      ],
      "env": {
        "UNITY_PROJECT_PATH": "${workspaceFolder}/unity/Tonight"
      }
    }
  }
}
