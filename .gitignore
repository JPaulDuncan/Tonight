# ---------------------------------------------------------------------------
# Unity
# ---------------------------------------------------------------------------
unity/Tonight/[Ll]ibrary/
unity/Tonight/[Tt]emp/
unity/Tonight/[Oo]bj/
unity/Tonight/[Bb]uild/
unity/Tonight/[Bb]uilds/
unity/Tonight/[Ll]ogs/
unity/Tonight/[Uu]ser[Ss]ettings/
unity/Tonight/[Mm]emoryCaptures/
unity/Tonight/[Rr]ecordings/

# Unity never-versioned caches
unity/Tonight/Assets/AssetStoreTools*
unity/Tonight/Assets/Plugins/Editor/JetBrains*
unity/Tonight/.vs/
unity/Tonight/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for ignored folders
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
unity/Tonight/sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# ---------------------------------------------------------------------------
# Blender
# ---------------------------------------------------------------------------
*.blend1
*.blend2
*.blend@
blender/exports/**/*.fbx
blender/exports/**/*.glb
blender/exports/**/*.gltf
blender/exports/**/*.obj
blender/exports/**/*.png
!blender/exports/.gitkeep
!blender/exports/**/README.md

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Node (tooling only)
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# ---------------------------------------------------------------------------
# Local secrets / machine-specific MCP overrides
# ---------------------------------------------------------------------------
.env
.env.local
.mcp.local.json
.claude/settings.local.json
